{
  "name": "file-rename",
  "version": "1.0.1",
  "description": "파일 이름 일괄 변경 앱",
  "scripts": {
    "tauri": "cargo tauri",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "build": "cargo tauri build && bash scripts/copy-to-dist.sh",
    "build:mac": "cargo tauri build && bash scripts/copy-to-dist.sh",
    "build:windows": "cargo tauri build --config '{\"bundle\":{\"targets\":[\"nsis\"]}}' --runner cargo-xwin --target x86_64-pc-windows-msvc && bash scripts/copy-to-dist.sh x86_64-pc-windows-msvc",
    "build:release": "bash scripts/build-release.sh",
    "release": "bash scripts/release-to-github.sh",
    "sync-version": "node scripts/sync-version.js"
  },
  "devDependencies": {},
  "dependencies": {}
}
